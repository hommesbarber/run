rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function okName(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 16;
    }
    function profileOrClaimUpdate(n, o) {
      return o.get('season', 0) > 0 &&
        n.diff(o).affectedKeys().hasOnly(['name', 'gender', 'claimSeason', 'claimAt']);
    }
    match /scores/{uid} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        okName(request.resource.data) && profileOrClaimUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }
    match /claims/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
